{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["react/*"],
      "styles/*": ["styles/*"]
    },
    "types": ["node", "vtex.styleguide/types"]
  },
  "include": [
    "react/**/*",
    "styles/**/*",
    "store/**/*",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["node_modules"]
}